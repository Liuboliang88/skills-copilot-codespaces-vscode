RFOOptimizer::RFOOptimizer(size_t dim, double trust_radius_) 
    : H(dim, dim), trust_radius(trust_radius_), first_step(true)   //初始化Hessian矩阵为单位矩阵 设置信任域半径。 标记为第一次步进。
{
    for (size_t i = 0; i < dim; ++i) H(i, i) = 1.0;  //使用 for 循环将 Hessian 矩阵 H 的对角线元素初始化为 1.0，即把 Hessian 矩阵初始化为单位矩阵。
}

