GEDIISOptimizer::GEDIISOptimizer(size_t dim, size_t minS, size_t maxS) //dim 表示优化问题的维度，通常用于确定 Hessian 矩阵的大小。
    : minSpace(minS), maxSpace(maxS), H(dim, dim), first_step(true)
{
    for (size_t i = 0; i < dim; ++i) H(i, i) = 1.0;   //构造函数体使用 for 循环将 Hessian 矩阵 H 的对角线元素设置为 1.0，即把 Hessian 矩阵初始化为单位矩阵。单位矩阵作为 Hessian 矩阵的初始值
}

void GEDIISOptimizer::reset() {
    xHist.clear(); gHist.clear(); EHist.clear();   //xHist、gHist 和 EHist 分别是存储历史点、历史梯度和历史能量的容器
    for (size_t i = 0; i < H.rows(); ++i)
        for (size_t j = 0; j < H.cols(); ++j)
            H(i, j) = (i == j ? 1.0 : 0.0);
    first_step = true;
}

void GEDIISOptimizer::update_hessian(const Matrix& x, const Matrix& g) {
    if (first_step) return;
    Matrix s = x - x_prev;
    Matrix y = g - g_prev;
    double sy = (s.trans() % y)(0);
    double yHy = (s.trans() % H % s)(0);
    if (std::abs(sy) < 1e-8 || std::abs(yHy) < 1e-8) {
        std::cerr << "sy or yHy is too small." << std::endl;
        return;
    } 
    H = H - (H % y % s.trans() + s % y.trans() % H) / sy + ((sy + yHy) / (sy*sy)) * (s % s.trans());   //BFGS更新Hessian
}

void GEDIISOptimizer::update_history(const Matrix& x, const Matrix& g, double E) {   // 存储当前结构、梯度、能量 维护一个滑动窗口：最多 maxSpace 个历史结构,超过就从前面弹出
    xHist.push_back(x);
    gHist.push_back(g);
    EHist.push_back(E);
    eHist.push_back(H.inver() % g);
    

    if (xHist.size() > maxSpace) {
        xHist.erase(xHist.begin());
        gHist.erase(gHist.begin());
        EHist.erase(EHist.begin());
    }
}

