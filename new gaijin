void RFOOptimizer::update_hessian(const Matrix& x, const Matrix& g) {  //接收当前点 x 和当前梯度 g 作为参数，用于更新 Hessian 矩阵。
    if (first_step) return;   //只要不是第一步，就用BFGS公式更新Hessian。第一步不用BFGS
    Matrix s = x - x_prev;    //计算当前点 x 与上一步点 x_prev 的差值，得到位移向量 s。
    Matrix y = g - g_prev;    //计算当前梯度 g 与上一步梯度 g_prev 的差值，得到梯度变化向量 y。
    double sy  = (s.trans() % y)(0);  //计算位移向量 s 的转置与梯度变化向量 y 的内积，结果存储在 sty 中。
    double yHy = (y.trans() % H % y)(0);  //计算位移向量 s 的转置、Hessian 矩阵 H 与位移向量 s 的乘积，结果存储在 stHs 中。
    if (std::abs(sy) < 1e-8 || std::abs(yHy) < 1e-8) return;
    H = H - (H % y % s.trans() + s % y.trans() % H) / sy + ((sy + yHy) / (sy*sy)) * (s % s.trans()); //BFGS公式
}

Matrix RFOOptimizer::step(const Matrix& x, const Matrix& g) {     //step 方法接收当前点 x 和梯度 g 作为参数，返回一个 Matrix 类型对象，表示优化后的下一个点。
    size_t N = x.size();  //获取当前点 x 的元素数量。
    assert(x.rows() == N && x.cols() == 1);  //确保 x 和 g 都是列向量，即只有一列。
    assert(g.rows() == N && g.cols() == 1);

    update_hessian(x, g);

    // RFO超矩阵
    Matrix RFOmat(N+1, N+1, 0.0);    //创建一个 (N + 1) x (N + 1) 的零矩阵 RFOmat。
    for (size_t i = 0; i < N; ++i)    //将 Hessian 矩阵 H 填充到 RFOmat 的左上角 N x N 子矩阵中。
    for (size_t j = 0; j < N; ++j)
        RFOmat(i, j) = H(i, j);

    for (size_t i = 0; i < N; ++i) {
        RFOmat(i, N) = g(i, 0);
        RFOmat(N, i) = g(i, 0);
    }
    RFOmat(N, N) = 0.0;   //将 RFOmat 的右下角元素置为 0。 

    // 特征分解
    SelfAdjointEigenSolver ses(RFOmat); 
    Matrix evals = ses.eigenVal();   //获取特征值矩阵 evals。
    Matrix evecs = ses.eigenVec();    //获取特征向量矩阵 evecs。

    // 选取最小λ且尾分量非零的特征向量
    double min_lambda = std::numeric_limits<double>::infinity();   //初始化 min_lambda 为正无穷，用于存储最小特征值。
    Matrix best_vec;
    int M = evals.size();
    for (int k = 0; k < M; ++k) {
        double lambda = evals(k, 0);
        const double tail = evecs(N, k);
        if (std::abs(tail) > 1e-8 && lambda < min_lambda) {   //遍历所有特征值，筛选出尾分量绝对值大于 1e-8 且特征值最小的特征向量，将其赋值给 best_vec。
            min_lambda = lambda;
            best_vec = Matrix(M, 1);
            for (int i = 0; i < M; ++i)
                best_vec(i, 0) = evecs(i, k);
        }
    }
    std::cout << "[RFO] x[0]=" << x(0,0) << " g[0]=" << g(0,0) << std::endl;
    if (best_vec.size() == 0) {    //若未找到符合条件的特征向量，输出错误信息并终止程序，返回当前点 x。
        std::cerr << "❌ RFO failed: no valid eigenvector found.\n";
        std::abort();
        return x;
    }
    std::cout << "[RFO] 选中特征值lambda=" << min_lambda << " 尾分量=" << best_vec(N,0) << std::endl;

    // 计算步长方向
    Matrix p(N, 1);   //创建一个 N x 1 的矩阵 p 用于存储步长方向。
    double norm2 = 0.0;
    for (size_t i = 0; i < N; ++i) {
        p(i, 0) = best_vec(i, 0) / best_vec(N, 0);
        norm2 += p(i, 0) * p(i, 0);
    }
    double step_norm = std::sqrt(norm2);   //计算步长方向向量 p，并计算其欧几里得范数 step_norm。
    std::cout << "[RFO] 步长norm=" << step_norm << std::endl;

    // Trust radius
    if (step_norm > trust_radius) {    //若步长范数超过信任区域半径 trust_radius，则对步长方向向量 p 进行缩放，使其范数等于信任区域半径。
        double scale = trust_radius / step_norm;
        for (size_t i = 0; i < N; ++i)
            p(i, 0) *= scale;
    }

    // Hessian更新
    // update_hessian(x, g);   //调用 update_hessian 方法更新 Hessian 矩阵。

    // 保存历史
    x_prev = x;
    g_prev = g;   //保存当前点 x 和梯度 g 作为历史记录。
    first_step = false;   //标记当前不是第一步。
    return x + p;   //返回当前点 x 加上步长方向向量 p，即优化后的下一个点。
}

