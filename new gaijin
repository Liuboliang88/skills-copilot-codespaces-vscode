#include "gdiisrfo.hpp"
#include <cassert>
#include <cmath>
#include <iostream>

RFO_DIIS_Optimizer::RFO_DIIS_Optimizer(size_t dim, size_t minS, size_t maxS, double trust_radius_, double cos_cutoff_, double step_ratio_)
    : minSpace(minS), maxSpace(maxS), H(dim, dim), trust_radius(trust_radius_), cos_cutoff(cos_cutoff_), step_ratio(step_ratio_), first_step(true)
{
    for (size_t i = 0; i < dim; ++i) H(i, i) = 1.0;
}

void RFO_DIIS_Optimizer::reset() {
    xHist.clear(); gHist.clear(); EHist.clear();
    for (size_t i = 0; i < H.rows(); ++i)
        for (size_t j = 0; j < H.cols(); ++j)
            H(i, j) = (i == j ? 1.0 : 0.0);
    first_step = true;
}

void RFO_DIIS_Optimizer::update_hessian(const Matrix& x, const Matrix& g) {
    if (first_step) return;
    Matrix s = x - x_prev;
    Matrix y = g - g_prev;
    double sty = (s.trans() % y)(0);
    double stHs = (s.trans() % H % s)(0);
    if (std::abs(sty) < 1e-8 || std::abs(stHs) < 1e-8) return;
    H = H + (y % y.trans()) / sty - (H % s % s.trans() % H.trans()) / stHs;
}

void RFO_DIIS_Optimizer::update_history(const Matrix& x, const Matrix& g, double E) {
    xHist.push_back(x);
    gHist.push_back(g);
    EHist.push_back(E);
    if (xHist.size() > maxSpace) {
        xHist.erase(xHist.begin());
        gHist.erase(gHist.begin());
        EHist.erase(EHist.begin());
    }
}

Matrix RFO_DIIS_Optimizer::gediis_step(const Matrix& x, const Matrix& g, double energy) {
    update_history(x, g, energy);
    size_t n = xHist.size();
    if (n < minSpace) return xHist.back();

    size_t ref = n - 1;
    Matrix B(n+1, n+1, 0.0);

    for (size_t i = 0; i < n; ++i) {
        for (size_t j = 0; j < n; ++j) {
            double e_part = (EHist[i] - EHist[ref]) * (EHist[j] - EHist[ref]);
            Matrix gi = gHist[i] - gHist[ref];
            Matrix gj = gHist[j] - gHist[ref];
            double g_part = (gi.trans() % gj)(0);
            B(i, j) = e_part + g_part;
        }
    }
    for (size_t i = 0; i < n; ++i)
        B(i, n) = B(n, i) = 1.0;
    B(n, n) = 0.0;

    Matrix b(n+1, 1, 0.0);
    b(n) = 1.0;

    Matrix c = B.solve(b);

    // 检查c是否有NaN
    for (size_t i = 0; i < c.rows(); ++i)
        if (std::isnan(c(i,0))) {
            std::cerr << "❌ GEDIIS权重系数c中有NaN，回退最新结构！" << std::endl;
            return xHist.back();
        }

    Matrix xnew = Matrix(xHist[0].rows(), xHist[0].cols(), 0.0);
    for (size_t i = 0; i < n; ++i)
        xnew += xHist[i] * c(i);

    // 检查xnew是否有NaN
    for (size_t i = 0; i < xnew.rows(); ++i)
        if (std::isnan(xnew(i,0))) {
            std::cerr << "❌ GEDIIS外推生成了NaN，回退最新结构！" << std::endl;
            return xHist.back();
        }

    return xnew;
}

Matrix RFO_DIIS_Optimizer::rfo_step(const Matrix& x, const Matrix& g) {
    size_t N = x.size();
    // RFO超矩阵
    Matrix RFOmat(N+1, N+1, 0.0);
    for (size_t i = 0; i < N; ++i)
        for (size_t j = 0; j < N; ++j)
            RFOmat(i, j) = H(i, j);
    for (size_t i = 0; i < N; ++i) {
        RFOmat(i, N) = g(i, 0);
        RFOmat(N, i) = g(i, 0);
    }
    RFOmat(N, N) = 0.0;

    // 特征分解
    SelfAdjointEigenSolver ses(RFOmat);
    Matrix evals = ses.eigenVal();
    Matrix evecs = ses.eigenVec();

    // 选取最小λ且尾分量非零的特征向量
    double min_lambda = std::numeric_limits<double>::infinity();
    Matrix best_vec;
    int M = evals.size();
    for (int k = 0; k < M; ++k) {
        double lambda = evals(k, 0);
        const double tail = evecs(N, k);
        if (std::abs(tail) > 1e-8 && lambda < min_lambda) {
            min_lambda = lambda;
            best_vec = Matrix(M, 1);
            for (int i = 0; i < M; ++i)
                best_vec(i, 0) = evecs(i, k);
        }
    }
    if (best_vec.size() == 0) {
        std::cerr << "❌ RFO failed: no valid eigenvector found.\n";
        std::abort();
        return x;
    }

    // 步长方向
    Matrix p(N, 1);
    double norm2 = 0.0;
    for (size_t i = 0; i < N; ++i) {
        p(i, 0) = best_vec(i, 0) / best_vec(N, 0);
        norm2 += p(i, 0) * p(i, 0);
    }
    double step_norm = std::sqrt(norm2);

    // Trust radius
    if (step_norm > trust_radius) {
        double scale = trust_radius / step_norm;
        for (size_t i = 0; i < N; ++i)
            p(i, 0) *= scale;
    }

    return x + p;
}

Matrix RFO_DIIS_Optimizer::step(const Matrix& x, const Matrix& g, double energy) {
    update_hessian(x, g);

    // 1. 生成GEDIIS外推步
    Matrix x_gdiis = gediis_step(x, g, energy);
    Matrix p_gdiis = x_gdiis - x;

    // 2. 生成RFO步
    Matrix x_rfo = rfo_step(x, g);
    Matrix p_rfo = x_rfo - x;

    // 3. 判据：方向接近且步长合理
    double dot = 0.0, norm_gdiis = 0.0, norm_rfo = 0.0;
    for (size_t i = 0; i < p_gdiis.rows(); ++i) {
        dot += p_gdiis(i,0) * p_rfo(i,0);
        norm_gdiis += p_gdiis(i,0) * p_gdiis(i,0);
        norm_rfo += p_rfo(i,0) * p_rfo(i,0);
    }
    norm_gdiis = std::sqrt(norm_gdiis);
    norm_rfo = std::sqrt(norm_rfo);

    double cos_theta = dot / (norm_gdiis * norm_rfo + 1e-12);

    bool accept = (cos_theta >= cos_cutoff) && (norm_gdiis <= step_ratio * norm_rfo);

    // 4. 保存历史
    update_history(x, g, energy);
    x_prev = x;
    g_prev = g;
    first_step = false;

    if (accept) {
        std::cout << "✔️  RFO-DIIS: Accept GEDIIS step (cosθ=" << cos_theta << ", |p_gdiis|=" << norm_gdiis << ", |p_rfo|=" << norm_rfo << ")\n";
        return x_gdiis;
    } else {
        std::cout << "❌  RFO-DIIS: Reject GEDIIS step, use RFO (cosθ=" << cos_theta << ", |p_gdiis|=" << norm_gdiis << ", |p_rfo|=" << norm_rfo << ")\n";
        return x_rfo;
    }
}

