#include "matrix.hpp"
#include <vector>

/**
 * RFO-DIIS混合优化器
 * - 维护自己的Hessian和历史结构
 * - step(x, g, E): 返回新结构
 *   - 先用GEDIIS历史外推生成候选步
 *   - 再用RFO生成参考步
 *   - 比较两步方向和步长，判据通过则接受GEDIIS步，否则退回RFO步
 */
class RFO_DIIS_Optimizer {
public:
    RFO_DIIS_Optimizer(
        size_t dim,
        size_t minSpace = 4,
        size_t maxSpace = 10,
        double trust_radius = 0.5,
        double cos_cutoff = 0.95,
        double step_ratio = 10.0
    );

    // 主步生成接口
    Matrix step(const Matrix& x, const Matrix& g, double energy);

    // 可选：重置历史和Hessian
    void reset();

private:
    size_t minSpace, maxSpace;
    Matrix H; // Hessian
    double trust_radius;
    double cos_cutoff;
    double step_ratio;
    bool first_step;
    Matrix x_prev, g_prev;

    std::vector<Matrix> xHist, gHist;
    std::vector<double> EHist;

    void update_hessian(const Matrix& x, const Matrix& g);
    void update_history(const Matrix& x, const Matrix& g, double E);

    // GEDIIS外推步
    Matrix gediis_step(const Matrix& x, const Matrix& g, double energy);

    // RFO步
    Matrix rfo_step(const Matrix& x, const Matrix& g);
};
