Vec3f64  operator*(const Vec3f64 &vec1, const Vec3f64 &vec2)
{ return Vec3f64(vec1.x * vec2.x, vec1.y * vec2.y, vec1.z * vec2.z); }

Vec3f64  operator/(const Vec3f64 &vec1, const Vec3f64 &vec2)
