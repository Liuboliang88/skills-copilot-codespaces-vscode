#include "molecule.hpp"
#include "utility.hpp"
#include "gdiis.hpp"

#include <iostream>
#include <cstdlib>
#include <algorithm>

// 判断所有原子梯度范数是否都小于阈值
bool converged(const std::vector<Vec3f64>& grads, double thresh) {
    for (const auto& g : grads) {
        if (g.len() > thresh) return false;
    }
    return true;
}

// 计算最大梯度范数
double max_gradient(const std::vector<Vec3f64>& grads) {
    double maxG = 0.0;
    for (const auto& g : grads) {
        maxG = std::max(maxG, g.len());
    }
    return maxG;
}

int main(int argc, char** argv) {
    if (argc != 2) {
        std::cerr << "usage: opt mol.txt\n";
        return 1;
    }

    Molecule mol = Molecule::from_gjf(argv[1]);
    std::size_t nAtom = mol.coords.size();

    const int    max_iter  = 100;
    const double thresh    = 1e-4;
    const double alpha     = 0.1;  // 简单松弛步长
    bool         is_conv   = false;

    GDIIS                             diis;
    std::vector<Vec3f64>              grads;
    std::vector<std::vector<Vec3f64>> grad_hist;  // 若你还想保留梯度历史

    for (std::size_t iter = 1; iter <= max_iter; ++iter) {
        // 1) 计算梯度
        grads = mol.calculate_gradient();
        double maxG = max_gradient(grads);
        std::printf("iter = %2zu, max grad = %.6f\n", iter, maxG);

        // 2) 收敛检查
        if (converged(grads, thresh)) {
            is_conv = true;
            break;
        }

        // 3)  construct “simple relaxation” erroe vector e_i = x_i^SR - x_i，
        //    其中 x_i^SR = x_i - alpha * grad_i
        std::vector<Vec3f64> error_vec(nAtom);
        for (std::size_t i = 0; i < nAtom; ++i) {
            Vec3f64 xi = mol.coords[i];
            Vec3f64 shift = grads[i] * (-alpha);
            Vec3f64 x_sr = xi + shift;
            error_vec[i] = x_sr - xi;  // e_i x_i^SR-x_i=H^-1*fi
        }

        // （可选）保存梯度历史
        grad_hist.push_back(grads);

        // 4) 打包成 Matrix
        Matrix xMat = vec3f64Vector_to_matrix(mol.coords)
                          .reshape(3 * nAtom, 1);
        Matrix rMat = vec3f64Vector_to_matrix(error_vec)
                          .reshape(3 * nAtom, 1);

        // 5) 调用 DIIS 更新：内部自己维护历史 / 构建方程 / 求解混合系数
        Matrix xNew = diis.update(xMat, rMat);

        // 6) 若 DIIS 返回 NaN，就退化到单步
        bool hasNaN = false;
        for (std::size_t k = 0; k < xNew.size(); ++k) {
            if (std::isnan(xNew(k))) {
                hasNaN = true;
                break;
            }
        }
        if (hasNaN) {
            std::cerr << "[DIIS] ❌ NaN detected, fallback to simple SR step\n";
            xNew = xMat + rMat;  // x_sr
        }

        // 7) 写回坐标
        mol.coords = matrix_to_vec3f64Vector(xNew.reshape(nAtom, 3));
    }

    std::cout << (is_conv ? "converged.\n" : "not converged\n");

    std::cout << "Final structure:\n" << mol.to_geometry() << "\n";
    std::cout << "Final forces:\n";
    for (auto& g : grads) {
        std::cout << g.to_string() << "\n";
    }

    return 0;
}

