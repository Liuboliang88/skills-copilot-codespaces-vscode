#include "molecule.hpp"
#include <cstdlib>
#include <fstream>
#include <sstream>
#include <iostream>

// ✅ 默认构造函数定义（补上这句解决链接错误）
Molecule::Molecule() : charge(0), multip(1) {}

// 构造函数：从自定义格式文本读取
Molecule::Molecule(const std::string& filename) {
    std::vector<std::string> filelines;

    std::ifstream ifs(filename);
    std::string line;
    while (std::getline(ifs, line)) {
        if (line.empty()) continue;
        filelines.push_back(line);
    }

    if (filelines.size() < 2) {
        std::cerr << "error in input file: " << filename << std::endl;
        std::abort();
    }

    std::istringstream iss(filelines[0]);
    iss >> charge >> multip;

    for (std::size_t i = 1; i < filelines.size(); ++i) {
        std::istringstream iss(filelines[i]);
        std::string s;
        Vec3f64 c;
        iss >> s >> c.x >> c.y >> c.z;
        symbol.push_back(s);
        coords.push_back(c);
    }
}

// ✅ from_gjf 静态方法：从 Gaussian-like 文件提取结构
Molecule Molecule::from_gjf(const std::string& filename) {
    Molecule mol;
    std::ifstream fin(filename);
    if (!fin) {
        std::cerr << "❌ Failed to open GJF file: " << filename << std::endl;
        std::abort();
    }

    std::string line;
    bool reading_atoms = false;

    while (std::getline(fin, line)) {
        if (line.empty()) {
            if (reading_atoms) break;
            continue;
        }

        std::istringstream iss(line);
        std::string symbol;
        double x, y, z;

        if (iss >> symbol >> x >> y >> z) {
            reading_atoms = true;
            mol.symbol.push_back(symbol);
            mol.coords.push_back(Vec3f64{x, y, z});
        } else if (reading_atoms) {
            break;
        }
    }

    if (mol.coords.empty()) {
        std::cerr << "❌ No atoms parsed from GJF file: " << filename << std::endl;
        std::abort();
    }

    mol.charge = 0;
    mol.multip = 1;
    return mol;
}

// 输出 Gaussian 坐标块（用于 .gjf）
std::string Molecule::to_geometry() const {
    std::string ret;
    char buff[128];

    if (symbol.size() != coords.size()) {
        std::cerr << "symbol.size() != coords.size()" << std::endl;
        std::abort();
    }

    for (size_t i = 0; i < symbol.size(); i++) {
        sprintf(buff, " %-2s %14.8lf %14.8lf %14.8lf",
                symbol[i].data(), coords[i].x, coords[i].y, coords[i].z);
        ret += std::string(buff) + "\n";
    }

    return ret;
}

// 输出为 gjf 坐标段（带电荷、自旋多重度）
std::string Molecule::to_string() const {
    char buff[128];
    std::sprintf(buff, "%d %d", charge, multip);
    std::string ret = std::string(buff) + "\n";
    return ret + this->to_geometry();
}

// 生成完整 Gaussian 输入文件内容
std::string Molecule::to_gjf() const {
    std::string methods = "# hf/6-31g force\n";
    std::string comment = "calculate force\n";
    std::string ret = methods + "\n" + comment + "\n";
    ret += this->to_string() + "\n";
    return ret;
}

// 调用 Gaussian 并解析力（负梯度）
std::vector<Vec3f64> Molecule::calculate_gradient() const {
    std::string jobname     = "force";
    std::string gjfFilename = jobname + ".gjf";
    std::string logFilename = jobname + ".log";

    std::ofstream gjfFile(gjfFilename);
    if (!gjfFile.good()) {
        std::cerr << "cannot write to " << gjfFilename << std::endl;
        std::abort();
    }

    gjfFile << this->to_gjf() << std::endl;
    gjfFile.close();

    std::string cmd = "g16 " + gjfFilename;
    int ret_code = std::system(cmd.data());
    if (ret_code != 0) {
        std::cerr << "run g16 job error." << std::endl;
        std::abort();
    }

    std::ifstream logFile(logFilename);
    if (!logFile.good()) {
        std::cerr << "cannot read log file: " << logFilename << std::endl;
        std::abort();
    }

    std::vector<std::string> logFileLines;
    std::string line;
    while (std::getline(logFile, line)) {
        logFileLines.push_back(line);
    }

    std::size_t idx = 0;
    while (idx < logFileLines.size()) {
        if (logFileLines[idx].find("Forces (Hartrees/Bohr)") != std::string::npos)
            break;
        ++idx;
    }

    if (idx >= logFileLines.size()) {
        std::cerr << "cannot find force in log file: " << logFilename << std::endl;
        std::abort();
    }

    idx += 3;
    std::vector<Vec3f64> gradient;

    for (; idx < logFileLines.size(); ++idx) {
        if (logFileLines[idx].find("----") != std::string::npos) break;

        int num1, num2;
        Vec3f64 force;
        std::istringstream iss(logFileLines[idx]);
        iss >> num1 >> num2 >> force.x >> force.y >> force.z;

        gradient.push_back(-force); // 负力 = 梯度
    }

    if (gradient.size() != symbol.size()) {
        std::cerr << "number of gradient error." << std::endl;
        std::abort();
    }

    return gradient;
}


