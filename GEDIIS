#include "geomopt.hpp"
#include <cassert>
#include <iostream>

const double alpha = 0.3;

Matrix GeomOpt::get_next_coord(const Matrix& x, 
                               const Matrix& g) {
    std::size_t N = x.size();
    assert(N % 3 == 0);

    assert(x.rows() == N);
    assert(x.cols() == 1);
    assert(g.rows() == N);
    assert(g.cols() == 1);

    if (H0.size() == 0) {
        // 初始化阶段：设置初始Hessian矩阵为单位矩阵
        H0 = Matrix(N, N);
        for (std::size_t i = 0; i < N; ++i) {
            H0(i, i) = 1.0;
        }

        x0 = x;
        g0 = g;

        // 纯BFGS：直接计算新坐标
        Matrix xnew = x0 - alpha * H0.inver() % g0;
        return xnew;
    }

    // BFGS迭代更新阶段
    x1 = x;
    g1 = g;

    Matrix s = x1 - x0;
    Matrix y = g1 - g0;

    double sty = (s.trans() % y)(0);
    double stHs = (s.trans() % H0 % s)(0);

    if (std::abs(sty) < 1e-8) {
        std::cerr << "❌ BFGS数值问题：sty = " << sty << " 太小，可能导致数值不稳定" << std::endl;
        std::cerr << "   建议检查梯度计算或调整初始结构" << std::endl;
        std::abort();
    }

    if (std::abs(stHs) < 1e-8) {
        std::cerr << "❌ BFGS数值问题：stHs = " << stHs << " 太小，可能导致数值不稳定" << std::endl;
        std::cerr << "   建议检查Hessian矩阵或调整初始结构" << std::endl;
        std::abort();
    }

    // BFGS公式更新Hessian矩阵
    H1 =  H0 + (y % y.trans()) / sty 
             - (H0 % s % s.trans() % H0.trans()) / stHs;
    
    // 纯BFGS：直接计算新坐标
    Matrix xnew = x1 - alpha * H1.inver() % g1;

    // 调试输出（可选）
    // std::cout << "  BFGS更新: sty=" << sty << " stHs=" << stHs << std::endl;

    // 更新历史数据
    x0 = x1;
    g0 = g1;
    H0 = H1;

    return xnew;
}

