GEDIIS::GEDIIS(size_t minS, size_t maxS)
    : minSpace(minS), maxSpace(maxS) {}

void GEDIIS::update_space(const Matrix& x, const Matrix& g, double E) {
    xHist.push_back(x);
    gHist.push_back(g);
    EHist.push_back(E);

    if (xHist.size() > maxSpace) {
        xHist.erase(xHist.begin());
        gHist.erase(gHist.begin());
        EHist.erase(EHist.begin());
    }
}

bool GEDIIS::ready() const {
    return xHist.size() >= minSpace;
}

// GEDIIS外推核心
Matrix GEDIIS::extrapolate_new_vector() const {
    size_t n = xHist.size();
    assert(n == gHist.size() && n == EHist.size());
    size_t ref = n - 1; // 参考点，取最新

    Matrix B(n+1, n+1, 0.0);

    for (size_t i = 0; i < n; ++i) {
        for (size_t j = 0; j < n; ++j) {
            // 能量部分
            double e_part = (EHist[i] - EHist[ref]) * (EHist[j] - EHist[ref]);
            // 梯度部分
            Matrix gi = gHist[i] - gHist[ref];
            Matrix gj = gHist[j] - gHist[ref];
            double g_part = (gi.trans() % gj)(0); // 向量点积
            B(i, j) = e_part + g_part;
        }
    }

    for (size_t i = 0; i < n; ++i)
        B(i, n) = B(n, i) = 1.0;
    B(n, n) = 0.0;

    Matrix b(n+1, 1, 0.0);
    b(n) = 1.0;

    Matrix c = B.solve(b);

    // 检查c是否有NaN
    for (size_t i = 0; i < c.rows(); ++i)
        if (std::isnan(c(i,0))) {
            std::cerr << "❌ GEDIIS权重系数c中有NaN，回退BFGS！" << std::endl;
            return xHist.back();
        }

    Matrix xnew = Matrix(xHist[0].rows(), xHist[0].cols(), 0.0);
    for (size_t i = 0; i < n; ++i)
        xnew += xHist[i] * c(i);

    // 检查xnew是否有NaN
    for (size_t i = 0; i < xnew.rows(); ++i)
        if (std::isnan(xnew(i,0))) {
            std::cerr << "❌ GEDIIS外推生成了NaN，回退BFGS！" << std::endl;
            return xHist.back();
        }

    return xnew;
}

// 检查所有原子对距离，返回是否有异常
bool check_structure(const std::vector<Vec3f64>& coords, double min_bond = 0.7, double max_bond = 2.0) {
    size_t n = coords.size();
    for (size_t i = 0; i < n; ++i) {
        for (size_t j = i+1; j < n; ++j) {
            double d = (coords[i] - coords[j]).len();
            if (d < min_bond || d > max_bond) {
                std::cerr << "⚠️ 结构异常: 原子对(" << i << "," << j << ") 距离=" << d << " Å" << std::endl;
                return false;
            }
        }
    }
    return true;
}

Matrix bfgs_step(const Matrix& x, const Matrix& g) {
    static Matrix H;      // Hessian近似
    static Matrix x_prev, g_prev;
    static bool first = true;
    const double alpha = 0.1;

    size_t N = x.size();

    if (first) {
        H = Matrix(N, N);
        for (size_t i = 0; i < N; ++i) H(i, i) = 1.0;
        x_prev = x;
        g_prev = g;
        first = false;
        return x - alpha * H.inver() % g;
    }

    Matrix s = x - x_prev;
    Matrix y = g - g_prev;
    double sty = (s.trans() % y)(0);
    double stHs = (s.trans() % H % s)(0);

    if (std::abs(sty) < 1e-8 || std::abs(stHs) < 1e-8) {
        std::cerr << "BFGS数值问题，sty或stHs过小，退化为梯度下降" << std::endl;
        return x - alpha * H.inver() % g;
    }

    H = H + (y % y.trans()) / sty - (H % s % s.trans() % H.trans()) / stHs;
    x_prev = x;
    g_prev = g;

    return x - alpha * H.inver() % g;
}

Matrix GEDIIS::update_and_extrapolate(const Matrix& xMat, const Matrix& gMat, double energy) {
    Matrix xNew;

    if (!ready()) {
        xNew = bfgs_step(xMat, gMat);
        update_space(xMat, gMat, energy);
    } else {
        xNew = extrapolate_new_vector();
        // ...结构检查...
        update_space(xMat, gMat, energy);
    }

    return xNew;
}
