// File: src/main.cpp

#include "cell.hpp"
#include "utility.hpp"
#include "geomopt.hpp"
#include "gediis.hpp"
#include <iostream>
#include <cstdlib>
#include <algorithm>
#include <vector>
#include <cstddef>

bool converged(const std::vector<Vec3f64>& grads, double thresh) {
    for (const auto& g : grads) {
        if (g.len() > thresh) return false;
    }
    return true;
}

double max_gradient(const std::vector<Vec3f64>& grads) {
    double maxG = 0.0;
    for (const auto& g : grads) {
        maxG = std::max(maxG, g.len());
    }
    return maxG;
}

double max_displacement(const std::vector<Vec3f64>& coords_old, 
                       const std::vector<Vec3f64>& coords_new) {
    double maxD = 0.0;
    for (size_t i = 0; i < coords_old.size(); ++i) {
        Vec3f64 dx = coords_new[i] - coords_old[i];
        maxD = std::max(maxD, dx.len());
    }
    return maxD;
}

void print(const std::vector<Vec3f64>& v) {
    for (const auto& vi : v) {
        std::cout << vi.to_string() << std::endl;
    }
}

int main(int argc, char** argv) {
    if (argc < 2 || argc > 3) {
        std::cerr << "Usage: opt POSCAR [vasp|gauss|both]\n";
        return 1;
    }

    std::string method = "vasp";               // 默认用 VASP
    if (argc == 3) method = argv[2];  
    std::transform(method.begin(), method.end(),
                   method.begin(), ::tolower);

    Cell cell = Cell::from_poscar(argv[1]);
    std::size_t nAtom = cell.coords.size();
    GeomOpt  opt;
    GEDIIS gediis(4, 10);
    const int    max_iter = 200;
    const double thresh   = 1e-6;
    bool         is_conv  = false;

    for (int iter = 1; iter <= max_iter; ++iter) {
        std::vector<Vec3f64> grads_vasp, grads_gauss, grads;
        
        // 保存旧坐标用于计算位移
        std::vector<Vec3f64> coords_old = cell.coords;
        double energy = 0.0;

        // 1) 根据 method 选择梯度来源
        if (method == "vasp" || method == "both") {
            grads_vasp = cell.calculate_gradient_from_vasp();
        }
        if (method == "gauss" || method == "both") {
            grads_gauss = cell.calculate_gradient_gauss(/*charge=*/0, /*multip=*/1);
            // 获取能量（仅Gaussian方法）
            energy = cell.get_energy_from_gauss();
        }

        // 2) 如果 both，则简单打印对比，不做优化
        if (method == "both") {
            std::cout << "=== Iter " << iter << " ===" << std::endl;
            std::cout << "VASP Forces:" << std::endl;
            print(grads_vasp);
            std::cout << "Gaussian Forces:" << std::endl;
            print(grads_gauss);
            std::cout << "Gaussian Energy: " << energy << " Hartree" << std::endl;
            return 0;  // 只做一次对比就退出
        }

        // 3) 迭代优化：把选中的梯度赋给 grads
        grads = (method == "gauss" ? grads_gauss : grads_vasp);

        // 4) 打印优化信息：能量、最大受力、最大位移
        double max_grad = max_gradient(grads);
        
        if (method == "gauss") {
            std::cout << "iter = " << iter 
                      << "  Energy = " << energy << " Hartree"
                      << "  Max_Force = " << max_grad << " Hartree/Bohr"
                      << std::endl;
        } else {
            std::cout << "iter = " << iter 
                      << "  Energy = N/A (VASP)"
                      << "  Max_Force = " << max_grad << " Hartree/Bohr"
                      << std::endl;
        }

        if (converged(grads, thresh)) {
            is_conv = true;
            std::cout << "✅ 收敛！最大梯度: " << max_grad << " < " << thresh << std::endl;
            break;
        }

        // 5) 构造矩阵，BFGS生成新坐标
        Matrix xMat = vec3f64Vector_to_matrix(cell.coords)
                          .reshape(3 * nAtom, 1);
        Matrix gMat = vec3f64Vector_to_matrix(grads)
                          .reshape(3 * nAtom, 1);
        Matrix xNew = gediis.update_and_extrapolate(xMat, gMat, energy);

        // 6) 写回坐标并应用步长限制
        const double max_step = 0.1;  // 最大步长限制（埃）

        std::vector<Vec3f64> coordNew = matrix_to_vec3f64Vector(xNew.reshape(nAtom, 3));
        for (std::size_t ic = 0; ic < nAtom; ++ic) {
            Vec3f64 dx = coordNew[ic] - cell.coords[ic];
            double dr = dx.len();

            if (dr > max_step) {
                dx *= (max_step / dr);
                coordNew[ic] = cell.coords[ic] + dx;
            }
        }

        // 计算实际发生的最大位移
        double max_disp = max_displacement(coords_old, coordNew);
        
        // 检查新坐标是否有NaN
        for (const auto& c : coordNew) {
            if (std::isnan(c.x) || std::isnan(c.y) || std::isnan(c.z)) {
                std::cerr << "❌ 优化步生成了NaN坐标，回退到上一步或终止！" << std::endl;
                // 可选择回退或直接abort
                std::abort();
            }
        }
        
        // 更新坐标
        cell.coords = coordNew;
        
        // 输出位移信息
        std::cout << "  Max_Disp = " << max_disp << " Angstrom" << std::endl;
    }

    std::cout << (is_conv ? "✅ Converged." : "❌ Not converged.")
              << std::endl;
    std::cout << "Final structure:" << std::endl
              << cell.to_geometry() << std::endl;

    return 0;
}
