// 默认构造函数
Cell::Cell() {
    std::system(
      "rm -rf "
      "CHG CHGCAR WAVECAR OUTCAR "
      "OSZICAR vasprun.xml vasp.log "
      "DOSCAR EIGENVAL IBZKPT XDATCAR "
      "PCDAT CONTCAR REPORT force.* "
    );
}

Cell Cell::from_poscar(const std::string& filename) {
    Cell cell;
    std::ifstream fin(filename);
    if (!fin) {
        std::cerr << "❌ Failed to open POSCAR file: " << filename << "\n";
        std::abort();
    }
    // 1) header + scale
    std::string line;
    std::getline(fin, line);  // comment

    std::getline(fin, line);  // scale factor
    double scale = std::stod(line);

    //  2) lattice vectors
    cell.lattice.resize(3);
    for (int i = 0; i < 3; ++i) {
        std::getline(fin, line);
        std::istringstream iss(line);
        iss >> cell.lattice[i].x >> cell.lattice[i].y >> cell.lattice[i].z;
        cell.lattice[i] = cell.lattice[i] * scale;
    }

    //  3) species & counts
    std::getline(fin, line);
    std::istringstream iss_species(line);
    std::string sp;
    while (iss_species >> sp) cell.species.push_back(sp);

    
    std::getline(fin, line);
    std::istringstream iss_num(line);
    int count;
    while (iss_num >> count) cell.num_atoms.push_back(count);

    // 4) build symbol list
    for (size_t i = 0; i < cell.species.size(); ++i)
        for (int j = 0; j < cell.num_atoms[i]; ++j)
            cell.symbols.push_back(cell.species[i]);

    // 5) detect "Direct" or "Cartesian" line
    bool is_direct = false;
    while (std::getline(fin, line)) {
        if (line.find("Direct") != std::string::npos) {
            is_direct = true;
            break;
        }
        if (line.find("Cartesian") != std::string::npos) {
            is_direct = false;
            break;
        }
    }

    // 6) read coordinates, 并在 fraction 模式下转换到 Cartesian
      cell.coords.resize(cell.symbols.size());
    for (size_t i = 0; i < cell.coords.size(); ++i) {
        Vec3f64 f;  // 如果是 Direct，先读到分数坐标
        fin >> f.x >> f.y >> f.z;
        if (is_direct) {
            // Cartesian = f.x·a + f.y·b + f.z·c
            Vec3f64 C = cell.lattice[0] * f.x
                      + cell.lattice[1] * f.y
                      + cell.lattice[2] * f.z;
            cell.coords[i] = C;
        } else {
            cell.coords[i] = f;
        }
    }

    for (const auto& c : cell.coords) {
        if (std::isnan(c.x) || std::isnan(c.y) || std::isnan(c.z)) {
            std::cerr << "❌ 检测到NaN坐标，终止优化！" << std::endl;
            std::abort();
        }
    }

    return cell;
}

std::string Cell::to_geometry() const {
    std::ostringstream oss;
    for (size_t i = 0; i < coords.size(); ++i)
        oss << symbols[i] << "  " << coords[i].x << "  "
            << coords[i].y << "  " << coords[i].z << "\n";
    return oss.str();
}

std::string Cell::to_poscar() const {
    std::ostringstream oss;
    oss << "VASP cell\n1.0\n";
    for (const auto& vec : lattice)
        // oss << vec.x << " " << vec.y << " " << vec.z << "\n";
        oss << vec.to_string() << std::endl;
    for (const auto& sp : species)
        oss << sp << " ";
    oss << "\n";
    for (const auto& num : num_atoms)
        oss << num << " ";
    oss << "\nCartesian\n";
    for (const auto& c : coords)
        // oss << c.x << " " << c.y << " " << c.z << "\n";
        oss << c.to_string() << std::endl;
    return oss.str();
}

std::vector<Vec3f64> Cell::calculate_gradient_from_vasp() const {
    const std::string job = "force";
    // 写 POSCAR
    std::ofstream fout("POSCAR");
    if (!fout) {
        std::cerr << "❌ Cannot write POSCAR file.\n";
        std::abort();
    }

    fout << this -> to_poscar();
    fout.close();

    // 写 POTCAR
    int code0 = std::system("echo 103 | vaspkit > /dev/null");
    if (code0 != 0) {
        std::cerr << "❌ Failed to generate POTCAR.\n";
        std::abort();
    }

    // 写 INCAR
    std::ofstream incar("INCAR");
    incar << 
R"(PREC = ACCURATE
IBRION  = -1
NSW     = 0
ENCUT   = 400
EDIFF   = 1e-06
EDIFFG  = -0.02
IVDW    = 12
ISMEAR  = 0
SIGMA   = 0.05
ISIF    = 2
ISPIN   = 1
# LDIPOL  = .TRUE.
# IDIPOL  = 3
LERAL   = Auto
ISTART  = 0
ICHARG  = 2)";

    incar.close();

    // 写 KPOINTS
    std::ofstream kpoints("KPOINTS");
    kpoints << "Gamma-point only\n0\nGamma\n1 1 1\n";
    kpoints.close();

    std::cout << "📎 Expecting POTCAR in working directory\n";
    std::cout << "⚙️  Running VASP (vasp_std > out.log)...\n";

    int code = std::system("mpirun -np 16 vasp_gam > vasp.log");
    if (code != 0) {
        std::cerr << "❌ VASP execution failed.\n";
        std::abort();
    }

    // 解析 OUTCAR 中的 TOTAL-FORCE
    std::ifstream log("OUTCAR");
    if (!log) {
        std::cerr << "❌ Cannot open OUTCAR.\n";
        std::abort();
    }

    const double sc = 0.0194469;

    std::vector<Vec3f64> forces;
    std::string line;
    while (std::getline(log, line)) {
        if (line.find("TOTAL-FORCE (eV/Angst)") != std::string::npos) {
            std::getline(log, line); // --------

            while (std::getline(log, line)) {
                if (line.find("--------") != std::string::npos) {
                    break;
                }

                std::istringstream iss(line);
                double x, y, z, fx, fy, fz;
                iss >> x >> y >> z >> fx >> fy >> fz;
                forces.push_back(Vec3f64(fx, fy, fz) * sc);
            }

            break;
        }
    }

    if (forces.size() != coords.size()) {
        std::cerr << "❌ Parsed force number mismatch (" << forces.size()
                  << " vs " << coords.size() << ").\n";
        std::abort();
    }

    return forces;
}


std::vector<Vec3f64> Cell::calculate_gradient_gauss(int charge,
                                                    int multip) const {
    const std::string job = "gauss";
    const std::string gjf = job + ".gjf";
    const std::string log = job + ".log";

    // 1) write .gjf input
    {
        std::ofstream f(gjf);
        f << "%chk=" << job << ".chk\n"
          << "# hf/6-31G(d) force\n\n"
          << "Force calculation\n\n"
          << charge << " " << multip << "\n";
        for (size_t i = 0; i < coords.size(); ++i) {
            f << symbols[i] << "  "
              << coords[i].x << "  "
              << coords[i].y << "  "
              << coords[i].z << "\n";
        }
        f << "\n";
    }

    // 2) use g16
    std::cout << "⚙️ Running Gaussian...\n";
    if (std::system(("g16 " + gjf + " > " + log).c_str()) != 0) {
        std::cerr << "❌ Gaussian failed.\n"; std::abort();
    }

    // 3) analys .log 中的 "Forces (Hartrees/Bohr)"
    std::ifstream fin(log);
    if (!fin) { std::cerr << "❌ Cannot open " << log << "\n"; std::abort(); }

    std::vector<Vec3f64> grads;
    std::string line;
    bool in_forces = false;
    while (std::getline(fin, line)) {
        if (!in_forces) {
            if (line.find("Forces (Hartrees/Bohr)") != std::string::npos) {
                // skip header lines
                std::getline(fin, line);
                std::getline(fin, line);
                in_forces = true;
            }
        } else {
            if (line.find("----") != std::string::npos) break;
            std::istringstream iss(line);
            int idx, Z;
            double fx, fy, fz;
            if (iss >> idx >> Z >> fx >> fy >> fz) {
                // gradient = –Force
                grads.emplace_back(-fx, -fy, -fz);
            }
        }
    }
    if (grads.size() != coords.size()) {
        std::cerr << "❌ Gaussian gradient count mismatch\n";
        std::abort();
    }
    return grads;
}

double Cell::get_energy_from_gauss() const {
    const std::string log = "gauss.log";
    std::ifstream fin(log);
    if (!fin) { 
        std::cerr << "❌ Cannot open " << log << "\n"; 
        std::abort(); 
    }

    double energy = 0.0;
    std::string line;
    bool found_energy = false;
    
    while (std::getline(fin, line)) {
        // 查找SCF Done行，包含最终能量
        if (line.find("SCF Done:") != std::string::npos) {
            std::istringstream iss(line);
            std::string token;
            // 跳过 "SCF Done: E(RHF) ="
            for (int i = 0; i < 4; ++i) {
                iss >> token;
            }
            // 读取能量值
            iss >> energy;
            found_energy = true;
            break;
        }
    }
    
    if (!found_energy) {
        std::cerr << "❌ 未能在Gaussian输出中找到能量信息\n";
        std::abort();
    }
    
    return energy;  // 返回Hartree单位的能量
}

