// 默认构造函数
Cell::Cell() {
    std::system(
      "rm -rf "
      "CHG CHGCAR WAVECAR OUTCAR "
      "OSZICAR vasprun.xml vasp.log "
      "DOSCAR EIGENVAL IBZKPT XDATCAR "
      "PCDAT CONTCAR REPORT force.* "
