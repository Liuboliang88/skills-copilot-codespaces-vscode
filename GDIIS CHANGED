void GDIIS::update_diis_space(const Matrix& x, 
                                const Matrix& e) {
    // 1) push history
    xHist.push_back(x);
    eHist.push_back(e);

    // 2) limit history size
    if (xHist.size() > maxSpace) {
        xHist.erase(xHist.begin());
        eHist.erase(eHist.begin());
    }
}

bool GDIIS::diis_space_ready() const {
    assert(xHist.size() == eHist.size());
    return xHist.size() >= minSpace;
}


Matrix GDIIS::extrapolate_new_vector() const {
    assert(xHist.size() == eHist.size());
    std::size_t n = xHist.size();

    Matrix B(n+1, n+1, 0.0);
    
    for(std::size_t i = 0; i < n; ++i) {
    for(std::size_t j = 0; j < n; ++j) {
        B(i,j) = (eHist[i].trans() % eHist[j])(0);
    }}

    for (std::size_t i = 0; i < n; ++i) {
        B(i, n) = B(n, i) = 1.0;
    }

    Matrix b(n+1, 1, 0.0);
    b(n) = 1.0;

    Matrix c = B.solve(b);

    assert(c.rows() == n+1);
    assert(c.cols() == 1);

    Matrix xdiis = Matrix(xHist.front().rows(), 
                          xHist.front().cols(), 0.0);
    for(std::size_t i = 0; i < n; ++i) {
        xdiis += xHist[i] * c(i);
    }
    
    return xdiis;
}

