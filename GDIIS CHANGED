#include "cell.hpp"
#include "utility.hpp"
#include "geomopt.hpp"

#include <iostream>
#include <cstdlib>
#include <algorithm>
#include <vector>
#include <cstddef>

bool converged(const std::vector<Vec3f64>& grads, double thresh) {
    for (const auto& g : grads) {
        if (g.len() > thresh) return false;
    }
    return true;
}

double max_gradient(const std::vector<Vec3f64>& grads) {
    double maxG = 0.0;
    for (const auto& g : grads) {
        maxG = std::max(maxG, g.len());
    }
    return maxG;
}

void print(const std::vector<Vec3f64>& v) {
    for (const auto& vi : v) {
        std::cout << vi.to_string() << std::endl;
    }
}

int main(int argc, char** argv) {
    if (argc < 2 || argc > 3) {
        std::cerr << "Usage: opt POSCAR [vasp|gauss|both]\n";
        return 1;
    }

    std::string method = "vasp";               // 默认用 VASP
    if (argc == 3) method = argv[2];  
    std::transform(method.begin(), method.end(),
                   method.begin(), ::tolower);

    Cell cell = Cell::from_poscar(argv[1]);
    std::size_t nAtom = cell.coords.size();
    GeomOpt  opt;
    const int    max_iter = 200;
    const double thresh   = 1e-3;
    bool         is_conv  = false;

    for (int iter = 1; iter <= max_iter; ++iter) {
        std::vector<Vec3f64> grads_vasp, grads_gauss, grads;

        // 1) 根据 method 选择梯度来源
        if (method == "vasp" || method == "both") {
            grads_vasp = cell.calculate_gradient_from_vasp();
        }
        if (method == "gauss" || method == "both") {
            grads_gauss = cell.calculate_gradient_gauss(/*charge=*/0, /*multip=*/1);
        }

        // 2) 如果 both，则简单打印对比，不做优化
        if (method == "both") {
            std::cout << "=== Iter " << iter << " ===" << std::endl;
            std::cout << "VASP Forces:" << std::endl;
            print(grads_vasp);
            std::cout << "Gaussian Forces:" << std::endl;
            print(grads_gauss);
            return 0;  // 只做一次对比就退出
        }

        // 3) 迭代优化：把选中的梯度赋给 grads
        grads = (method == "gauss" ? grads_gauss : grads_vasp);

        // 4) 打印一下本步信息
        double max_grad = max_gradient(grads);
        std::cout << "iter = " << iter
                  << "  max grad = " << max_grad
                  << "  [method=" << method << "]"
                  << std::endl;

        if (converged(grads, thresh)) {
            is_conv = true;
            std::cout << "✅ 收敛！最大梯度: " << max_grad << " < " << thresh << std::endl;
            break;
        }

        // 5) 构造矩阵，BFGS生成新坐标
        Matrix xMat = vec3f64Vector_to_matrix(cell.coords)
                          .reshape(3 * nAtom, 1);
        Matrix gMat = vec3f64Vector_to_matrix(grads)
                          .reshape(3 * nAtom, 1);
        Matrix xNew = opt.get_next_coord(xMat, gMat);

        // 6) 写回坐标并应用步长限制
        const double max_step = 0.1;  // 最大步长限制（埃）

        std::vector<Vec3f64> coordNew = matrix_to_vec3f64Vector(xNew.reshape(nAtom, 3));
        for (std::size_t ic = 0; ic < nAtom; ++ic) {
            Vec3f64 dx = coordNew[ic] - cell.coords[ic];
            double dr = dx.len();

            if (dr > max_step) {
                dx *= (max_step / dr);
                coordNew[ic] = cell.coords[ic] + dx;
            }
        }

        cell.coords = coordNew;
    }

    std::cout << (is_conv ? "✅ Converged." : "❌ Not converged.")
              << std::endl;
    std::cout << "Final structure:" << std::endl
              << cell.to_geometry() << std::endl;

    return 0;
}
